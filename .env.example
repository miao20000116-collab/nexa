# Database (optional in local dev — falls back to .nexa-data)
DATABASE_URL=

# Persistence (production / Netlify)
# NEXA_RUNTIME=serverless
# NEXA_REQUIRE_DATABASE=1
# NEXA_ALLOW_LOCAL_DATA=0
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# AUTH_SECRET=
# SESSION_SECRET=

# Object storage (optional locally; recommended in production)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
# COS_REGION=ap-guangzhou
# COS_BUCKET=
# COS_SECRET_ID=
# COS_SECRET_KEY=

# Redis (Tencent worker queue; optional on Netlify)
# REDIS_URL=

# Web Search (SearXNG self-hosted instance)
SEARXNG_BASE_URL=http://localhost:8080

# Optional compliant server-side egress for public-source metadata/read preview.
# Do not use this to promise raw foreign-site playback to mainland users.
NEXA_FETCH_PROXY=

# YouTube Data API (server-side only; often unreachable from CN)
YOUTUBE_API_KEY=

# ─────────────────────────────────────────────
# AI Provider — Nexa server only
# NEVER put these in NEXT_PUBLIC_* / localStorage / HTML / client responses
# ─────────────────────────────────────────────
# Active primary provider key (only one enabled in V2.1):
# domestic_openai | qwen | deepseek | doubao | gemini | openai
NEXA_AI_PRIMARY_PROVIDER=domestic_openai

AI_BASE_URL=
AI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_MAIN=
AI_MODEL_REASONING=
AI_MODEL_VISION=
AI_MODEL_EMBED=
AI_TIMEOUT_MS=60000
NEXA_AI_REGION=cn

# Optional per-vendor overrides (used when NEXA_AI_PRIMARY_PROVIDER matches)
# QWEN_BASE_URL=
# QWEN_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_API_KEY=

# Media
# Image generation uses AI_MEDIA_* if set, otherwise AI_BASE_URL + AI_API_KEY
# Set NEXA_IMAGE_ENABLED=0 to force-disable even when keys exist
NEXA_IMAGE_ENABLED=1
NEXA_VIDEO_ENABLED=0
NEXA_MUSIC_ENABLED=0
NEXA_TTS_ENABLED=0
# AI_MEDIA_BASE_URL=
# AI_MEDIA_API_KEY=
# AI_MODEL_IMAGE=dall-e-3

# 即梦 Jimeng 视频（火山引擎 Visual CV）— 优先于 AI_MEDIA_* 视频
# 控制台开通「即梦AI-视频生成3.0 1080P」免费试用后填写 IAM Access Key
# JIMENG_ACCESS_KEY=
# JIMENG_SECRET_KEY=
# JIMENG_REQ_KEY=jimeng_t2v_v30_1080p
# JIMENG_I2V_REQ_KEY=jimeng_i2v_first_v30_1080
# NEXA_VIDEO_PROVIDER=jimeng
# NEXA_VIDEO_ENABLED=1

# Optional remote video understanding. Nexa sends an authorized public URL to
# this service and stores only compact shot/timecode analysis, never the
# original platform video bytes. Leave blank to use title/summary/cover only.
# VIDEO_REFERENCE_ANALYZER_URL=
# VIDEO_REFERENCE_ANALYZER_API_KEY=

# Optional remote MCP servers for the AI Workbench Agent. URLs are server-only.
# Nexa verifies the MCP handshake and exposes only connector status/tool names.
# NEXA_MCP_BROWSER_URL=https://your-mcp.example.com/mcp
# NEXA_MCP_CODEGRAPH_URL=https://your-mcp.example.com/mcp

# Credits usage tracking (no recharge UI)
NEXA_CREDITS_COST_TABLE={"generateText":2,"reason":3,"research":15,"analyzeImage":4,"qualityCheck":1,"generateImage":8,"editImage":8,"summarize":1,"rewrite":2,"generateVideo":20,"generateMusic":10}

# Search debug mode (development only)
SEARCH_DEBUG=false
