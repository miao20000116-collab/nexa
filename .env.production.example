# ═══════════════════════════════════════════════════════════
# Nexa production / preview environment template
# Copy values into Netlify UI or server .env — NEVER commit secrets.
# ═══════════════════════════════════════════════════════════

# --- Core ---
NODE_ENV=production
# Netlify sets this automatically when NEXA_RUNTIME=serverless in netlify.toml
NEXA_RUNTIME=serverless
# Force DB; disable ephemeral .nexa-data (recommended for Netlify + 腾讯云)
NEXA_REQUIRE_DATABASE=1
NEXA_ALLOW_LOCAL_DATA=0

# Public site URL (Netlify: https://your-site.netlify.app or custom domain)
NEXT_PUBLIC_APP_URL=

# --- Database (REQUIRED for Netlify / production) ---
# Use Neon / Supabase / Prisma Postgres / 腾讯云 PostgreSQL
DATABASE_URL=

# --- Redis (optional on Netlify preview; required for 腾讯云 worker queue) ---
REDIS_URL=

# --- Object storage: AWS S3 or Tencent COS (S3-compatible) ---
# Prefer COS for 国内生产；Netlify preview 也建议配置以免媒体丢失
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=0
# Or Tencent COS aliases:
# COS_ENDPOINT=
# COS_REGION=ap-guangzhou
# COS_BUCKET=
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_PUBLIC_BASE_URL=

# --- Search ---
# Must be a URL reachable FROM the deploy environment (not localhost on Netlify)
SEARXNG_BASE_URL=
NEXA_FETCH_PROXY=
YOUTUBE_API_KEY=
SEARCH_DEBUG=false

# --- AI providers (server-only; never NEXT_PUBLIC_*) ---
NEXA_AI_PRIMARY_PROVIDER=domestic_openai
NEXA_AI_REGION=cn
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_MAIN=
AI_MODEL_REASONING=
AI_MODEL_VISION=
AI_MODEL_EMBED=
AI_TIMEOUT_MS=60000
# QWEN_BASE_URL=
# QWEN_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_API_KEY=

# Media / image
NEXA_IMAGE_ENABLED=1
NEXA_VIDEO_ENABLED=0
NEXA_MUSIC_ENABLED=0
NEXA_TTS_ENABLED=0
# AI_MEDIA_BASE_URL=
# AI_MEDIA_API_KEY=
# AI_MODEL_IMAGE=

# 即梦 Jimeng (Volcengine Visual)
# JIMENG_ACCESS_KEY=
# JIMENG_SECRET_KEY=
# JIMENG_REQ_KEY=jimeng_t2v_v30_1080p
# JIMENG_I2V_REQ_KEY=jimeng_i2v_first_v30_1080
# NEXA_VIDEO_PROVIDER=jimeng

# VIDEO_REFERENCE_ANALYZER_URL=
# VIDEO_REFERENCE_ANALYZER_API_KEY=

# MCP (server-only)
# NEXA_MCP_BROWSER_URL=
# NEXA_MCP_CODEGRAPH_URL=

NEXA_CREDITS_COST_TABLE={"generateText":2,"reason":3,"research":15,"analyzeImage":4,"qualityCheck":1,"generateImage":8,"editImage":8,"summarize":1,"rewrite":2,"generateVideo":20,"generateMusic":10}

# --- Auth / session ---
# Generate a long random string for cookie signing / future hardening
AUTH_SECRET=
SESSION_SECRET=
# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
# TikTok / X OAuth (optional; mainland playback limitations apply)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=

# --- CORS (comma-separated origins; leave empty for same-origin only) ---
CORS_ALLOWED_ORIGINS=

# --- Admin bootstrap (first deploy only; change immediately) ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=

# --- Observability ---
# Sentry or compatible DSN — optional
SENTRY_DSN=
LOG_LEVEL=info

# --- Netlify ↔ API origin notes ---
# If the Next app on Netlify calls a separate API host later:
# NEXT_PUBLIC_API_ORIGIN=https://api.example.com
# China mainland production MUST use 腾讯云 entry, not Netlify alone.
